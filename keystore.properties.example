# Copia este archivo a `keystore.properties` y rellena tus valores.
# `keystore.properties` y el .jks están fuera de git (ver .gitignore).
#
# Genera un keystore de release con:
#   keytool -genkeypair -v -keystore "$HOME/.android/spentz-release.jks" \
#     -alias spentz -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile puede ser absoluto o relativo a la raíz del repo.
storeFile=C:/Users/tu-usuario/.android/spentz-release.jks
storePassword=CAMBIA_ESTO
keyAlias=spentz
keyPassword=CAMBIA_ESTO
